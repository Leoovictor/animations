 "cues": [
  {
   "line": "l01",
   "t0": 0.34,
   "t1": 2.475,
   "text": "Mãe, abre! Sou eu!"
  },
  {
   "line": "l02",
   "t0": 2.515,
   "t1": 4.355,
   "text": "Caio congelou."
  },
  {
   "line": "l02",
   "t0": 4.395,
   "t1": 6.195,
   "text": "Aquela era a voz dele."
  },
  {
   "line": "l03",
   "t0": 6.77,
   "t1": 8.25,
   "text": "Caio tinha acabado de acordar"
  },
  {
   "line": "l03",
   "t0": 8.29,
   "t1": 11.03,
   "text": "descalço numa rua coberta de neblina."
  },
  {
   "line": "l03",
   "t0": 11.23,
   "t1": 14.858,
   "text": "Só havia uma casa com luz acesa. A dele."
  },
  {
   "line": "l04",
   "t0": 14.898,
   "t1": 17.078,
   "text": "Quando ouviu a própria voz lá dentro,"
  },
  {
   "line": "l04",
   "t0": 17.118,
   "t1": 19.918,
   "text": "deu dois passos pra trás e saiu correndo."
  },
  {
   "line": "l05",
   "t0": 20.17,
   "t1": 22.03,
   "text": "Virou a esquina."
  },
  {
   "line": "l05",
   "t0": 22.07,
   "t1": 24.037,
   "text": "Correu até perder o fôlego."
  },
  {
   "line": "l06",
   "t0": 24.077,
   "t1": 26.016,
   "text": "E chegou na mesma porta."
  },
  {
   "line": "l07",
   "t0": 26.056,
   "t1": 28.516,
   "text": "Mãe, abre! Sou eu!"
  },
  {
   "line": "l08",
   "t0": 28.77,
   "t1": 32.67,
   "text": "Na segunda volta, Caio riscou a parede com uma pedra."
  },
  {
   "line": "l08",
   "t0": 32.71,
   "t1": 35.427,
   "text": "Na terceira, passou pelo mesmo risco."
  },
  {
   "line": "l09",
   "t0": 35.467,
   "t1": 39.009,
   "text": "Foi aí que reparou numa menina sentada no meio-fio."
  },
  {
   "line": "l10",
   "t0": 39.22,
   "t1": 41.125,
   "text": "Quanto tempo faz que eu tô aqui?"
  },
  {
   "line": "l11",
   "t0": 41.165,
   "t1": 43.205,
   "text": "Pra você? Uns minutos."
  },
  {
   "line": "l11",
   "t0": 43.245,
   "t1": 45.581,
   "text": "Eu já te vi passar sete vezes."
  },
  {
   "line": "l12",
   "t0": 45.621,
   "t1": 47.681,
   "text": "Caio olhou pra parede."
  },
  {
   "line": "l12",
   "t0": 47.721,
   "t1": 50.381,
   "text": "Por baixo do risco que acabara de fazer,"
  },
  {
   "line": "l12",
   "t0": 50.421,
   "t1": 52.221,
   "text": "havia outros seis."
  },
  {
   "line": "l13",
   "t0": 52.72,
   "t1": 54.05,
   "text": "Que lugar é esse?"
  },
  {
   "line": "l14",
   "t0": 54.09,
   "t1": 58.17,
   "text": "Chamam de Umbral. Eu também acordo sempre na mesma rua."
  },
  {
   "line": "l15",
   "t0": 58.77,
   "t1": 61.69,
   "text": "A voz atrás da porta chamou de novo."
  },
  {
   "line": "l15",
   "t0": 61.75,
   "t1": 65.413,
   "text": "Só que, dessa vez, Caio ficou até ouvir o resto."
  },
  {
   "line": "l16",
   "t0": 65.453,
   "t1": 67.573,
   "text": "Mãe, abre! Sou eu!"
  },
  {
   "line": "l16",
   "t0": 67.613,
   "t1": 69.873,
   "text": "Eu voltei pra buscar meu irmão!"
  },
  {
   "line": "l17",
   "t0": 70.22,
   "t1": 72.46,
   "text": "Ele lembrou do incêndio."
  },
  {
   "line": "l17",
   "t0": 72.5,
   "t1": 74.791,
   "text": "Lembrou de voltar correndo pra casa."
  },
  {
   "line": "l18",
   "t0": 74.831,
   "t1": 77.811,
   "text": "E lembrou da mão do irmão escapando da sua."
  },
  {
   "line": "l19",
   "t0": 78.77,
   "t1": 82.168,
   "text": "Com a mão na maçaneta, Caio viu a menina se levantar."
  },
  {
   "line": "l20",
   "t0": 82.208,
   "t1": 84.068,
   "text": "Se você conseguir sair…"
  },
  {
   "line": "l20",
   "t0": 84.108,
   "t1": 86.751,
   "text": "pode perguntar se alguém tá procurando por mim?"
  },
  {
   "line": "l21",
   "t0": 86.791,
   "t1": 88.871,
   "text": "Caio soltou a maçaneta."
  },
  {
   "line": "l22",
   "t0": 89.22,
   "t1": 90.571,
   "text": "Qual é o seu nome?"
  },
  {
   "line": "l23",
   "t0": 90.611,
   "t1": 91.6,
   "text": "Lia."
  },
  {
   "line": "l24",
   "t0": 91.64,
   "t1": 94.36,
   "text": "Ele estendeu a mão. Quando Lia se"
  },
  {
   "line": "l24",
   "t0": 94.4,
   "t1": 97.14,
   "text": "levantou, a luz da casa apagou."
  },
  {
   "line": "l24",
   "t0": 97.18,
   "t1": 99.24,
   "text": "Pela primeira vez, a neblina baixou"
  },
  {
   "line": "l24",
   "t0": 99.28,
   "t1": 101.704,
   "text": "o suficiente pra mostrar o fim da rua."
  },
  {
   "line": "l25",
   "t0": 101.744,
   "t1": 103.804,
   "text": "Havia outra porta lá."
  },
  {
   "line": "l26",
   "t0": 104.27,
   "t1": 106.29,
   "text": "Antes que os dois chegassem perto,"
  },
  {
   "line": "l26",
   "t0": 106.33,
   "t1": 108.1,
   "text": "alguém bateu do outro lado."
  },
  {
   "line": "l27",
   "t0": 108.14,
   "t1": 111.34,
   "text": "Caio? Sou eu. Seu irmão."
  },
  {
   "line": "l27",
   "t0": 111.38,
   "t1": 113.511,
   "text": "Dessa vez, me espera."
  },
  {
   "line": "l28",
   "t0": 113.551,
   "t1": 115.387,
   "text": "Lia apertou a mão dele."
  },
  {
   "line": "l29",
   "t0": 115.427,
   "t1": 119.427,
   "text": "Caio… essa é a voz que me chama toda vez que eu acordo aqui."
  },
  {
   "line": "l30",
   "t0": 120.32,
   "t1": 122.24,
   "text": "Você abriria a porta?"
  },
  {
   "line": "l30",
   "t0": 122.52,
   "t1": 124.54,
   "text": "Comenta ABRE ou ESPERA e me conta"
  },
  {
   "line": "l30",
   "t0": 124.58,
   "t1": 127.24,
   "text": "quem você acha que tá do outro lado."
  },
  {
   "line": "l30",
   "t0": 127.4,
   "t1": 131.34,
   "text": "O voto mais escolhido decide o que Caio faz na parte 2."
  }
 ]
}