 "cues": [
  {
   "line": "l01",
   "t0": 0.42,
   "t1": 2.121,
   "text": "Caio, sai daí!"
  },
  {
   "line": "l02",
   "t0": 2.161,
   "t1": 4.461,
   "text": "Era a voz do irmão dele."
  },
  {
   "line": "l02",
   "t0": 4.581,
   "t1": 7.101,
   "text": "Só que vinha de dentro de uma gravação."
  },
  {
   "line": "l03",
   "t0": 7.27,
   "t1": 9.37,
   "text": "Vocês votaram ABRE."
  },
  {
   "line": "l03",
   "t0": 9.41,
   "t1": 10.56,
   "text": "E Caio abriu."
  },
  {
   "line": "l04",
   "t0": 10.6,
   "t1": 13.82,
   "text": "Do outro lado, encontrou a cozinha de casa."
  },
  {
   "line": "l04",
   "t0": 13.98,
   "t1": 16.9,
   "text": "O relógio estava parado às 3h17."
  },
  {
   "line": "l04",
   "t0": 17.3,
   "t1": 20.94,
   "text": "Em cima da mesa, um celular tocava o mesmo áudio."
  },
  {
   "line": "l05",
   "t0": 21.38,
   "t1": 24.405,
   "text": "Caio, sai daí! Eu já tô na rua!"
  },
  {
   "line": "l06",
   "t0": 24.445,
   "t1": 26.011,
   "text": "Caio deu play de novo."
  },
  {
   "line": "l07",
   "t0": 26.051,
   "t1": 27.552,
   "text": "Eu já tô na rua!"
  },
  {
   "line": "l08",
   "t0": 27.592,
   "t1": 30.972,
   "text": "Ele tinha voltado pra casa pra buscar o irmão."
  },
  {
   "line": "l08",
   "t0": 31.012,
   "t1": 34.172,
   "text": "A mensagem dizia que o irmão já tinha saído."
  },
  {
   "line": "l09",
   "t0": 35.02,
   "t1": 35.915,
   "text": "Caio?"
  },
  {
   "line": "l10",
   "t0": 35.955,
   "t1": 39.715,
   "text": "Dessa vez, a voz respondeu quando ele chamou de volta."
  },
  {
   "line": "l11",
   "t0": 40.27,
   "t1": 42.67,
   "text": "Caio correu até a janela."
  },
  {
   "line": "l11",
   "t0": 42.71,
   "t1": 44.73,
   "text": "Viu o irmão do outro lado do vidro,"
  },
  {
   "line": "l11",
   "t0": 44.77,
   "t1": 47.03,
   "text": "com os olhos cheios d’água."
  },
  {
   "line": "l11",
   "t0": 47.07,
   "t1": 48.57,
   "text": "Atrás dele, a mãe segurava"
  },
  {
   "line": "l11",
   "t0": 48.61,
   "t1": 50.85,
   "text": "uma camiseta de Caio junto ao peito."
  },
  {
   "line": "l12",
   "t0": 50.89,
   "t1": 53.07,
   "text": "Caio bateu no vidro."
  },
  {
   "line": "l12",
   "t0": 53.11,
   "t1": 54.766,
   "text": "Nenhum dos dois olhou."
  },
  {
   "line": "l13",
   "t0": 54.806,
   "t1": 58.215,
   "text": "Então o irmão encostou a testa na janela e sussurrou:"
  },
  {
   "line": "l14",
   "t0": 58.255,
   "t1": 60.815,
   "text": "Dessa vez, me espera."
  },
  {
   "line": "l15",
   "t0": 61.32,
   "t1": 63.168,
   "text": "Lia se aproximou devagar."
  },
  {
   "line": "l16",
   "t0": 63.208,
   "t1": 65.148,
   "text": "É essa a voz que me acorda."
  },
  {
   "line": "l16",
   "t0": 65.188,
   "t1": 67.959,
   "text": "Só que, comigo, ela sempre fala outra coisa."
  },
  {
   "line": "l17",
   "t0": 67.999,
   "t1": 68.862,
   "text": "O quê?"
  },
  {
   "line": "l18",
   "t0": 68.902,
   "t1": 71.822,
   "text": "“Se encontrar meu irmão, diz que eu saí.”"
  },
  {
   "line": "l19",
   "t0": 72.22,
   "t1": 73.684,
   "text": "Caio olhou pra ela."
  },
  {
   "line": "l20",
   "t0": 73.724,
   "t1": 75.603,
   "text": "Por que você nunca me contou?"
  },
  {
   "line": "l21",
   "t0": 75.643,
   "t1": 78.743,
   "text": "Eu só descobri seu nome quando você perguntou o meu."
  },
  {
   "line": "l21",
   "t0": 78.783,
   "t1": 82.463,
   "text": "Em todas as outras voltas, você passou correndo por mim."
  },
  {
   "line": "l22",
   "t0": 84.27,
   "t1": 86.85,
   "text": "A janela se abriu sozinha."
  },
  {
   "line": "l22",
   "t0": 86.89,
   "t1": 90.06,
   "text": "Do outro lado, o irmão de Caio estendeu a mão."
  },
  {
   "line": "l23",
   "t0": 90.1,
   "t1": 92.955,
   "text": "Caio ia pegar quando sentiu Lia soltar a dele."
  },
  {
   "line": "l24",
   "t0": 92.995,
   "t1": 93.766,
   "text": "Vai."
  },
  {
   "line": "l25",
   "t0": 93.806,
   "t1": 95.606,
   "text": "Você vem comigo."
  },
  {
   "line": "l26",
   "t0": 95.77,
   "t1": 98.07,
   "text": "Lia tentou se aproximar."
  },
  {
   "line": "l26",
   "t0": 98.11,
   "t1": 101.29,
   "text": "A cozinha desapareceu debaixo dos pés dela."
  },
  {
   "line": "l26",
   "t0": 101.45,
   "t1": 104.71,
   "text": "Por um segundo, Caio viu a menina de volta no meio-fio,"
  },
  {
   "line": "l26",
   "t0": 104.75,
   "t1": 107.21,
   "text": "na mesma rua onde tinha acordado."
  },
  {
   "line": "l27",
   "t0": 107.27,
   "t1": 109.717,
   "text": "Então ouviu uma mulher gritar da neblina:"
  },
  {
   "line": "l28",
   "t0": 109.757,
   "t1": 113.446,
   "text": "Lia! Dessa vez, responde quando ouvir minha voz!"
  },
  {
   "line": "l29",
   "t0": 113.486,
   "t1": 115.286,
   "text": "Caio… é a minha mãe."
  },
  {
   "line": "l30",
   "t0": 116.82,
   "t1": 120.44,
   "text": "Caio espera pelo irmão ou vai com Lia atrás da mãe dela?"
  },
  {
   "line": "l30",
   "t0": 120.74,
   "t1": 122.66,
   "text": "Comenta IRMÃO ou LIA."
  },
  {
   "line": "l30",
   "t0": 122.86,
   "t1": 125.92,
   "text": "O voto mais escolhido decide a parte 3."
  }
 ]
}