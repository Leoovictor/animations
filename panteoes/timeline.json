 "lines": {
  "s01": {
   "t0": 0.35,
   "t1": 3.377,
   "text": "E se Zeus descobrisse que não era o único senhor dos trovões?"
  },
  "s02": {
   "t0": 4.8,
   "t1": 7.806,
   "text": "Tudo começou quando um estranho portal apareceu no Monte Olimpo."
  },
  "s03": {
   "t0": 8.8,
   "t1": 12.431,
   "text": "Convencido de que nada poderia ameaçá-lo, Zeus decidiu atravessar."
  },
  "s04": {
   "t0": 13.8,
   "t1": 17.568,
   "text": "Mas, do outro lado, encontrou um mundo completamente diferente."
  },
  "s05": {
   "t0": 18.8,
   "t1": 22.663,
   "text": "Antes que pudesse entender onde estava, um trovão fez a terra estremecer."
  },
  "s06": {
   "t0": 24.5,
   "t1": 28.619,
   "text": "Era Xangô, Orixá associado à justiça, aos raios e aos trovões."
  },
  "s07a": {
   "t0": 30.3,
   "t1": 32.056,
   "text": "Zeus olhou para ele e perguntou:"
  },
  "s07b": {
   "t0": 32.306,
   "t1": 34.862,
   "text": "“Desde quando existe outro senhor dos trovões?”"
  },
  "s08a": {
   "t0": 36.4,
   "t1": 37.507,
   "text": "Xangô respondeu:"
  },
  "s08b": {
   "t0": 38.057,
   "t1": 40.856,
   "text": "“O céu não pertence a um único povo.”"
  },
  "s09": {
   "t0": 42.8,
   "t1": 47.433,
   "text": "Zeus lançou um raio para demonstrar seu poder. Xangô respondeu com outro."
  },
  "s10": {
   "t0": 49.3,
   "t1": 52.379,
   "text": "Mas a colisão provocou algo que nenhum dos dois esperava."
  },
  "s11": {
   "t0": 53.8,
   "t1": 56.984,
   "text": "Ogum foi o primeiro a perceber que os dois mundos estavam em perigo."
  },
  "s12a": {
   "t0": 58.3,
   "t1": 61.496,
   "text": "Então, uma tempestade ainda maior tomou conta do lugar."
  },
  "s12b": {
   "t0": 61.796,
   "t1": 63.163,
   "text": "Iansã havia chegado."
  },
  "s13": {
   "t0": 64.8,
   "t1": 68.916,
   "text": "Pela primeira vez, Zeus percebeu que não conhecia todas as forças daquele mundo."
  },
  "s14": {
   "t0": 71.5,
   "t1": 75.167,
   "text": "Foi quando uma criatura desconhecida começou a atravessar a rachadura."
  },
  "s15": {
   "t0": 77.0,
   "t1": 81.263,
   "text": "Antes que começassem uma batalha, Oxalá surgiu e revelou uma verdade."
  },
  "s16a": {
   "t0": 82.3,
   "t1": 84.171,
   "text": "O portal não surgiu por acaso."
  },
  "s16b": {
   "t0": 85.071,
   "t1": 88.058,
   "text": "Alguém queria colocar os dois panteões uns contra os outros."
  },
  "s17": {
   "t0": 89.3,
   "t1": 93.159,
   "text": "E agora, o destino desses dois mundos depende da decisão de vocês."
  },
  "s18": {
   "t0": 94.3,
   "t1": 98.967,
   "text": "No próximo episódio, cada mil curtidas desbloqueia uma pista sobre quem abriu o portal."
  },
  "s19": {
   "t0": 101.3,
   "t1": 107.302,
   "text": "Opção A: Zeus e Xangô deixam suas diferenças de lado e investigam juntos a origem do portal."
  },
  "s20": {
   "t0": 108.3,
   "t1": 113.603,
   "text": "Opção B: Ogum e Iansã atravessam o portal para descobrir o que está tentando entrar."
  },
  "s21a": {
   "t0": 114.8,
   "t1": 119.047,
   "text": "Comente A ou B. O caminho mais votado será o próximo episódio."
  },
  "s21b": {
   "t0": 119.497,
   "t1": 120.857,
   "text": "Mas escolham rápido..."
  },
  "s21c": {
   "t0": 121.007,
   "t1": 123.24,
   "text": "porque aquilo já começou a atravessar."
  }
 },
